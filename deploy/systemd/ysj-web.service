[Unit]
Description=YSJ Next.js website
After=network-online.target ysj-jin10.service ysj-vix.service
Wants=network-online.target

[Service]
Type=simple
User=__YSJ_USER__
WorkingDirectory=__YSJ_ROOT__
EnvironmentFile=__YSJ_ROOT__/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/npm run start -- --hostname 0.0.0.0 --port 3000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
