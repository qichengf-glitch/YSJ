[Unit]
Description=YSJ CN Option VIX collector and dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__YSJ_USER__
WorkingDirectory=__YSJ_ROOT__
EnvironmentFile=__YSJ_ROOT__/.env
Environment=PYTHONUNBUFFERED=1
Environment=PATH=__YSJ_ROOT__/cn_option_vix/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/usr/bin/bash __YSJ_ROOT__/scripts/start_vix_service.sh
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
