JIN10_SECRET_KEY=
JIN10_BASE_URL=https://open-data-api.jin10.com/data-api
DATABASE_PATH=./data/us_dashboard.db
DASHBOARD_TIMEZONE=Asia/Shanghai
SYNC_PAST_DAYS=7
SYNC_FUTURE_DAYS=30
LOG_POLL_INTERVAL_MINUTES=1
FULL_SYNC_INTERVAL_MINUTES=180
ENABLE_SCHEDULER=true
DEV_RELOAD=false
REQUEST_RETRIES=3
PRICE_PROVIDER=yfinance
PRICE_CACHE_MINUTES=5
PREDICTION_QUOTE_INTERVAL_MINUTES=2
PREDICTION_HISTORY_INTERVAL_MINUTES=30
PREDICTION_WHALE_INTERVAL_MINUTES=10
PREDICTION_SYNC_MAX_PAGES=15
PREDICTION_SYNC_MIN_PROB=0.10
PREDICTION_SYNC_MIN_VOLUME=10000
PREDICTION_STALE_AFTER_MINUTES=6
WHALE_STALE_AFTER_MINUTES=20
