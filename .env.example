# Next.js access control (replace both values in production)
YSJ_ACCESS_PASSCODE=CHANGE_ME
YSJ_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# Server-side backend addresses. These are never exposed to the browser.
MARKET_RADAR_BACKEND_URL=http://127.0.0.1:8000
CN_VIX_BACKEND_URL=http://127.0.0.1:8765
# Vercel + Render deployment: set this to the Render CN VIX service URL.
NEXT_PUBLIC_VIX_DASHBOARD_URL=
# Unified-server deployment: leave NEXT_PUBLIC_VIX_DASHBOARD_URL empty and use this same-origin proxy path.
VIX_DASHBOARD_PUBLIC_URL=/api/cn-option-vix-dashboard/index.html

# Jin10 backend
JIN10_SECRET_KEY=
JIN10_BASE_URL=https://open-data-api.jin10.com/data-api
DATABASE_PATH=./data/us_dashboard.db
DASHBOARD_TIMEZONE=Asia/Shanghai
SYNC_PAST_DAYS=7
SYNC_FUTURE_DAYS=30
LOG_POLL_INTERVAL_MINUTES=1
FULL_SYNC_INTERVAL_MINUTES=180
ENABLE_SCHEDULER=true
REQUEST_RETRIES=3
PRICE_PROVIDER=yfinance
PRICE_CACHE_MINUTES=5
PREDICTION_QUOTE_INTERVAL_MINUTES=2
PREDICTION_HISTORY_INTERVAL_MINUTES=30
PREDICTION_WHALE_INTERVAL_MINUTES=10
PREDICTION_SYNC_MAX_PAGES=15
PREDICTION_SYNC_MIN_PROB=0.10
PREDICTION_SYNC_MIN_VOLUME=10000
PREDICTION_STALE_AFTER_MINUTES=6
WHALE_STALE_AFTER_MINUTES=20

# CN Option VIX collector. Web-only mode works without RQDATA_URI.
RQDATA_URI=
CN_VIX_DB=./cn_option_vix/data/live_vix.sqlite
# 1 = repair missed trading dates at service startup and at 08:50 / 15:20 Shanghai time.
CN_VIX_AUTO_BACKFILL=1
CN_VIX_REPAIR_TIMES=08:50,15:20
CN_VIX_BACKFILL_RESERVE_MIB=64
CN_VIX_CATCHUP_LOOKBACK_TRADING_DAYS=10
CN_VIX_RQ_LOCK=./run/cn_vix_rqdata.lock
CN_VIX_RQ_LOCK_TIMEOUT_SECONDS=900
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8765
